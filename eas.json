{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": false
            },
            "env": {
                "APP_ENV": "development",
                "EXPO_PUBLIC_APP_SCHEME": "bandlink-dev"
            }
        },
        "preview": {
            "distribution": "internal",
            "ios": {
                "resourceClass": "m-medium"
            },
            "env": {
                "APP_ENV": "preview",
                "EXPO_PUBLIC_APP_SCHEME": "bandlink-preview"
            }
        },
        "production": {
            "autoIncrement": true,
            "ios": {
                "resourceClass": "m-medium"
            },
            "env": {
                "APP_ENV": "production",
                "EXPO_PUBLIC_APP_SCHEME": "bandlink"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "YOUR_APPLE_ID@example.com"
            }
        }
    }
}