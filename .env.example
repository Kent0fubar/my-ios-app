# === ローカル / 本番開発共通 ===
# App内で process.env.EXPO_PUBLIC_XXX として読み込める環境変数です
#
# 注意:
# 1. このファイルをコピーして `.env.production` 等のファイルを作成してください
# 2. .env 系のファイルはバージョン管理に含めないことが推奨されます（すでに .gitignore 済み）

# --- Supabase 接続情報 ---
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
